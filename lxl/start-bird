#!/usr/bin/env bash
###############################################################################
# start-bird - 启动 bird 阶段
###############################################################################

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# 加载环境变量
if [ -f "${SCRIPT_DIR}/env.sh" ]; then
    source "${SCRIPT_DIR}/env.sh"
fi

# 使用已有实验目录或创建新的
create_experiment_dir
log_start "start-bird"

# 日志输出到实验目录
LOG_FILE="${EXPERIMENT_DIR}/start-bird.log"
exec > >(tee -a "${LOG_FILE}") 2>&1

# 设置 KUBECONFIG
export KUBECONFIG="${REPO_ROOT}/output/kubeconfigs/${SEED_K3S_CLUSTER_NAME}.yaml"

echo "=== Start Bird ==="
echo "Log file: ${LOG_FILE}"

python3 "${SCRIPT_DIR}/seed_k8s_start_bird0130.py" "${SEED_NAMESPACE}" "${EXPERIMENT_DIR}"

echo "Start bird completed"
log_end "start-bird"