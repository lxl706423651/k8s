#!/usr/bin/env bash
###############################################################################
# clean - 清理阶段（大规模友好版：优先删 controllers，再删 namespace）
###############################################################################

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# 加载环境变量
if [ -f "${SCRIPT_DIR}/env_9node.sh" ]; then
    source "${SCRIPT_DIR}/env_9node.sh"
elif [ -f "${SCRIPT_DIR}/env.sh" ]; then
    source "${SCRIPT_DIR}/env.sh"
fi

# 使用已有实验目录或创建新的
create_experiment_dir
log_start "clean"

# 日志输出到实验目录
LOG_FILE="${EXPERIMENT_DIR}/clean.log"
exec > >(tee -a "${LOG_FILE}") 2>&1

# 设置 KUBECONFIG
export KUBECONFIG="${REPO_ROOT}/output/kubeconfigs/${SEED_K3S_CLUSTER_NAME}.yaml"

# 可调参数
NS="${SEED_NAMESPACE}"
CHECK_INTERVAL="${SEED_CLEAN_CHECK_INTERVAL_SECONDS:-30}"
TIMEOUT_SECONDS="${SEED_CLEAN_TIMEOUT_SECONDS:-7200}"
FORCE_FINALIZER_CLEANUP="${SEED_CLEAN_FORCE_FINALIZER_CLEANUP:-false}"
AUTO_FINALIZE_STUCK_NAMESPACE="${SEED_CLEAN_AUTO_FINALIZE_STUCK_NAMESPACE:-true}"
AUTO_FINALIZE_AFTER_SECONDS="${SEED_CLEAN_AUTO_FINALIZE_AFTER_SECONDS:-120}"

echo "=== Clean ==="
echo "Log file: ${LOG_FILE}"
echo "Namespace: ${NS}"
echo "Check interval: ${CHECK_INTERVAL}s"
echo "Timeout: ${TIMEOUT_SECONDS}s"
echo "Force finalizer cleanup on timeout: ${FORCE_FINALIZER_CLEANUP}"
echo "Auto finalize stuck empty namespace: ${AUTO_FINALIZE_STUCK_NAMESPACE}"
echo "Auto finalize after: ${AUTO_FINALIZE_AFTER_SECONDS}s"

if [ "${CLEAN_NAMESPACE}" != "true" ]; then
    echo "Skipping cleanup (CLEAN_NAMESPACE=false)"
    log_end "clean"
    exit 0
fi

count_namespaced_kind() {
    local resource="$1"
    kubectl -n "${NS}" get "${resource}" --ignore-not-found --no-headers 2>/dev/null \
        | wc -l | tr -d ' '
}

residual_resource_summary() {
    local pod_count deploy_count sts_count ds_count job_count nad_count configmap_count secret_count
    local sa_count svc_count role_count rb_count total
    pod_count="$(count_namespaced_kind pods)"
    deploy_count="$(count_namespaced_kind deploy)"
    sts_count="$(count_namespaced_kind sts)"
    ds_count="$(count_namespaced_kind ds)"
    job_count="$(count_namespaced_kind jobs.batch)"
    nad_count="$(count_namespaced_kind network-attachment-definitions.k8s.cni.cncf.io)"
    configmap_count="$(count_namespaced_kind configmaps)"
    secret_count="$(count_namespaced_kind secrets)"
    sa_count="$(count_namespaced_kind serviceaccounts)"
    svc_count="$(count_namespaced_kind services)"
    role_count="$(count_namespaced_kind roles.rbac.authorization.k8s.io)"
    rb_count="$(count_namespaced_kind rolebindings.rbac.authorization.k8s.io)"
    total=$((pod_count + deploy_count + sts_count + ds_count + job_count + nad_count + configmap_count + secret_count + sa_count + svc_count + role_count + rb_count))
    printf 'total=%s pods=%s deploy=%s sts=%s ds=%s jobs=%s nads=%s cm=%s secrets=%s sa=%s svc=%s roles=%s rolebindings=%s\n' \
        "${total}" "${pod_count}" "${deploy_count}" "${sts_count}" "${ds_count}" "${job_count}" "${nad_count}" "${configmap_count}" "${secret_count}" "${sa_count}" "${svc_count}" "${role_count}" "${rb_count}"
}

residual_summary_value() {
    local summary="$1"
    local key="$2"
    awk -v k="${key}" '
        {
            for (i = 1; i <= NF; i++) {
                split($i, kv, "=")
                if (kv[1] == k) {
                    print kv[2]
                    exit
                }
            }
        }
    ' <<< "${summary}"
}

namespaced_api_resources() {
    kubectl api-resources --verbs=list --namespaced -o name 2>/dev/null | sort -u
}

delete_all_namespaced_resources() {
    local resource
    while IFS= read -r resource; do
        [ -n "${resource}" ] || continue
        kubectl -n "${NS}" delete "${resource}" --all --ignore-not-found --wait=false >/dev/null 2>&1 || true
    done < <(namespaced_api_resources)
}

namespace_exists() {
    kubectl get namespace "${NS}" >/dev/null 2>&1
}

ensure_namespace_exists_if_residuals_present() {
    local summary total
    summary="$(residual_resource_summary)"
    total="$(residual_summary_value "${summary}" total)"
    if namespace_exists; then
        return 0
    fi
    if [ "${total:-0}" -gt 0 ]; then
        echo "Namespace object is absent, but residual namespaced resources still exist: ${summary}"
        echo "Recreating namespace ${NS} temporarily so cleanup can remove the leftover objects cleanly..."
        kubectl create namespace "${NS}" >/dev/null 2>&1 || true
        return 0
    fi
    return 1
}

print_namespace_snapshot() {
    local elapsed="$1"
    local ns_phase summary
    ns_phase="$(kubectl get namespace "${NS}" -o jsonpath='{.status.phase}' 2>/dev/null || echo "Unknown")"
    summary="$(residual_resource_summary)"
    echo "[${elapsed}s] Namespace still exists. phase=${ns_phase}, ${summary}"
}

dump_timeout_diagnostics() {
    echo ""
    echo "Current namespace object:"
    kubectl get namespace "${NS}" -o yaml || true
    echo ""
    echo "Namespace finalizers:"
    kubectl get namespace "${NS}" -o jsonpath='{.spec.finalizers}' 2>/dev/null || true
    echo ""
    echo ""
    echo "Remaining resources summary:"
    kubectl -n "${NS}" get deploy,sts,ds,job,pods -o wide 2>/dev/null || true
    echo ""
    echo "Recent events:"
    kubectl -n "${NS}" get events --sort-by='.lastTimestamp' 2>/dev/null | tail -n 100 || true
    echo ""
}

force_clear_namespace_finalizers() {
    local tmp_json
    tmp_json="$(mktemp)"
    kubectl get namespace "${NS}" -o json > "${tmp_json}"
    python3 - <<PY "${tmp_json}"
import json, sys
path = sys.argv[1]
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)
data.setdefault("spec", {})["finalizers"] = []
with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f)
PY
    kubectl replace --raw "/api/v1/namespaces/${NS}/finalize" -f "${tmp_json}" || true
    rm -f "${tmp_json}"
}

namespace_ready_for_safe_finalize() {
    local ns_json tmp_py
    ns_json="$(kubectl get namespace "${NS}" -o json 2>/dev/null || true)"
    [ -n "${ns_json}" ] || return 1

    tmp_py="$(mktemp)"
    cat > "${tmp_py}" <<'PY'
import json
import sys

data = json.load(sys.stdin)
spec_finalizers = data.get("spec", {}).get("finalizers") or []
if spec_finalizers != ["kubernetes"]:
    raise SystemExit(1)

conditions = {
    item.get("type"): item.get("status")
    for item in data.get("status", {}).get("conditions", [])
}

safe = (
    conditions.get("NamespaceContentRemaining") == "False"
    and conditions.get("NamespaceFinalizersRemaining") == "False"
    and conditions.get("NamespaceDeletionContentFailure") == "True"
)

raise SystemExit(0 if safe else 1)
PY

    if ! printf '%s' "${ns_json}" | python3 "${tmp_py}"; then
        rm -f "${tmp_py}"
        return 1
    fi
    rm -f "${tmp_py}"

    local pod_count deploy_count sts_count ds_count job_count
    local summary total
    summary="$(residual_resource_summary)"
    total="$(residual_summary_value "${summary}" total)"
    [ "${total:-1}" = "0" ]
}

if ! namespace_exists; then
    if ! ensure_namespace_exists_if_residuals_present; then
        echo "Namespace ${NS} does not exist and no residual namespaced resources were detected. Nothing to clean."
        log_end "clean"
        exit 0
    fi
fi

echo ""
echo "[1/3] Fast-delete namespaced resources first..."
delete_all_namespaced_resources

echo ""
echo "[2/3] Submit namespace deletion..."
kubectl delete namespace "${NS}" --wait=false || true

echo ""
echo "[3/3] Waiting for namespace to disappear completely..."

start_ts="$(date +%s)"
deadline=$((start_ts + TIMEOUT_SECONDS))
auto_finalize_attempted=false

while true; do
    now="$(date +%s)"
    elapsed=$((now - start_ts))

    if ! kubectl get namespace "${NS}" >/dev/null 2>&1; then
        echo "[${elapsed}s] Namespace ${NS} has been fully deleted."
        echo "Clean completed"
        log_end "clean"
        exit 0
    fi

    if [ "${AUTO_FINALIZE_STUCK_NAMESPACE}" = "true" ] &&
       [ "${auto_finalize_attempted}" = "false" ] &&
       [ "${elapsed}" -ge "${AUTO_FINALIZE_AFTER_SECONDS}" ] &&
       namespace_ready_for_safe_finalize; then
        echo "[${elapsed}s] Namespace content is already empty but kubernetes finalizer is stuck after API timeout."
        echo "[${elapsed}s] Performing safe finalizer cleanup for namespace ${NS}..."
        force_clear_namespace_finalizers
        auto_finalize_attempted=true
        sleep 5
        continue
    fi

    if [ "${now}" -ge "${deadline}" ]; then
        echo "[${elapsed}s] ERROR: Timed out waiting for namespace ${NS} deletion."
        dump_timeout_diagnostics
        if [ "${FORCE_FINALIZER_CLEANUP}" = "true" ]; then
            echo ""
            echo "Attempting force finalizer cleanup for namespace ${NS}..."
            force_clear_namespace_finalizers
            echo "Submitted namespace finalizer cleanup request."
        fi
        exit 1
    fi

    print_namespace_snapshot "${elapsed}"

    sleep "${CHECK_INTERVAL}"
done
