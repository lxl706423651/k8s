SHELL := /usr/bin/env bash
.SHELLFLAGS := -euo pipefail -c

RUNNING_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
ORIGIN_DIR := $(abspath $(RUNNING_DIR)/..)
NATIVE_RUNNING_DIR := $(ORIGIN_DIR)/running
OUTPUT_DIR ?= ../emulate/output
OUTPUT_DIR := $(abspath $(OUTPUT_DIR))

IMAGE_REGISTRY_PREFIX ?= seedemu
REGISTRY_PREFIX ?= 192.168.122.110:5000
KUBECONFIG ?= /home/lxl/k8s/output/kubeconfigs/seedemu-k3s.yaml
INVENTORY ?= /home/lxl/k8s/configs/clusters/seedemu-k3s-12node.yaml
NODE_ROLE_FILTER ?= all
SSH_USER ?= ubuntu
SSH_KEY ?= /home/lxl/.ssh/id_ed25519

MANIFEST ?= $(OUTPUT_DIR)/k8s.yaml
SCALE_MANIFEST ?= $(OUTPUT_DIR)/k8s_scale.yaml
IMAGES_YAML ?= $(OUTPUT_DIR)/images.yaml
KUSTOMIZATION ?= $(OUTPUT_DIR)/kustomization.yaml
RENDERED_MANIFEST ?= $(OUTPUT_DIR)/k8s_scale_rendered.yaml
NODE_IMAGE_DIR ?= $(OUTPUT_DIR)/node_image_refs
DEPLOY_BATCH_DIR ?= $(OUTPUT_DIR)/scale_deploy_batches

HELPER ?= $(RUNNING_DIR)/scale_helper.py
OPTIMIZER ?= $(ORIGIN_DIR)/optimize_k8s_by_as.py
PREFLIGHT ?= $(RUNNING_DIR)/scalepreflight.sh
BUILD ?= $(RUNNING_DIR)/scalebuild.sh
UP ?= $(RUNNING_DIR)/scaleup.sh
CLEAN ?= $(RUNNING_DIR)/scaleclean.sh

PRELOAD_NODE_CONCURRENCY ?= 3
PRELOAD_BATCH_SIZE ?= 10
PRELOAD_RETRIES ?= 3
PRELOAD_BACKOFF_SECONDS ?= 5

DEPLOY_BATCH_SIZE ?= 20
DEPLOY_BATCH_SLEEP_SECONDS ?= 20
DEPLOY_WARMUP_BATCHES ?= 3
DEPLOY_WARMUP_BATCH_SIZE ?= 5
DEPLOY_PRESSURE_CHECK_SECONDS ?= 10
DEPLOY_STABILIZE_TIMEOUT_SECONDS ?= 3600
DEPLOY_MAX_PENDING_PODS ?= 100
DEPLOY_MAX_CREATING_PODS ?= 150
DEPLOY_MAX_NOTREADY_PODS ?= 250
DEPLOY_MAX_FAILED_PODS ?= 5

.PHONY: scalepreflight scalebuild scaleup scaleclean

scalepreflight:
	@OUTPUT_DIR="$(OUTPUT_DIR)" MANIFEST="$(MANIFEST)" SCALE_MANIFEST="$(SCALE_MANIFEST)" \
	  IMAGES_YAML="$(IMAGES_YAML)" KUSTOMIZATION="$(KUSTOMIZATION)" NODE_IMAGE_DIR="$(NODE_IMAGE_DIR)" \
	  INVENTORY="$(INVENTORY)" NODE_ROLE_FILTER="$(NODE_ROLE_FILTER)" KUBECONFIG="$(KUBECONFIG)" \
	  REGISTRY_PREFIX="$(REGISTRY_PREFIX)" IMAGE_REGISTRY_PREFIX="$(IMAGE_REGISTRY_PREFIX)" \
	  SSH_USER="$(SSH_USER)" SSH_KEY="$(SSH_KEY)" HELPER="$(HELPER)" OPTIMIZER="$(OPTIMIZER)" \
	  bash "$(PREFLIGHT)"

scalebuild: scalepreflight
	@OUTPUT_DIR="$(OUTPUT_DIR)" SCALE_MANIFEST="$(SCALE_MANIFEST)" IMAGES_YAML="$(IMAGES_YAML)" \
	  NODE_IMAGE_DIR="$(NODE_IMAGE_DIR)" INVENTORY="$(INVENTORY)" NODE_ROLE_FILTER="$(NODE_ROLE_FILTER)" \
	  REGISTRY_PREFIX="$(REGISTRY_PREFIX)" IMAGE_REGISTRY_PREFIX="$(IMAGE_REGISTRY_PREFIX)" \
	  SSH_USER="$(SSH_USER)" SSH_KEY="$(SSH_KEY)" HELPER="$(HELPER)" NATIVE_RUNNING_DIR="$(NATIVE_RUNNING_DIR)" \
	  PRELOAD_NODE_CONCURRENCY="$(PRELOAD_NODE_CONCURRENCY)" PRELOAD_BATCH_SIZE="$(PRELOAD_BATCH_SIZE)" \
	  PRELOAD_RETRIES="$(PRELOAD_RETRIES)" PRELOAD_BACKOFF_SECONDS="$(PRELOAD_BACKOFF_SECONDS)" \
	  bash "$(BUILD)"

scaleup: scalepreflight
	@OUTPUT_DIR="$(OUTPUT_DIR)" SCALE_MANIFEST="$(SCALE_MANIFEST)" IMAGES_YAML="$(IMAGES_YAML)" \
	  KUSTOMIZATION="$(KUSTOMIZATION)" RENDERED_MANIFEST="$(RENDERED_MANIFEST)" DEPLOY_BATCH_DIR="$(DEPLOY_BATCH_DIR)" \
	  INVENTORY="$(INVENTORY)" NODE_ROLE_FILTER="$(NODE_ROLE_FILTER)" KUBECONFIG="$(KUBECONFIG)" \
	  REGISTRY_PREFIX="$(REGISTRY_PREFIX)" IMAGE_REGISTRY_PREFIX="$(IMAGE_REGISTRY_PREFIX)" HELPER="$(HELPER)" \
	  DEPLOY_BATCH_SIZE="$(DEPLOY_BATCH_SIZE)" DEPLOY_BATCH_SLEEP_SECONDS="$(DEPLOY_BATCH_SLEEP_SECONDS)" \
	  DEPLOY_WARMUP_BATCHES="$(DEPLOY_WARMUP_BATCHES)" DEPLOY_WARMUP_BATCH_SIZE="$(DEPLOY_WARMUP_BATCH_SIZE)" \
	  DEPLOY_PRESSURE_CHECK_SECONDS="$(DEPLOY_PRESSURE_CHECK_SECONDS)" DEPLOY_STABILIZE_TIMEOUT_SECONDS="$(DEPLOY_STABILIZE_TIMEOUT_SECONDS)" \
	  DEPLOY_MAX_PENDING_PODS="$(DEPLOY_MAX_PENDING_PODS)" DEPLOY_MAX_CREATING_PODS="$(DEPLOY_MAX_CREATING_PODS)" \
	  DEPLOY_MAX_NOTREADY_PODS="$(DEPLOY_MAX_NOTREADY_PODS)" DEPLOY_MAX_FAILED_PODS="$(DEPLOY_MAX_FAILED_PODS)" \
	  bash "$(UP)"

scaleclean:
	@OUTPUT_DIR="$(OUTPUT_DIR)" SCALE_MANIFEST="$(SCALE_MANIFEST)" MANIFEST="$(MANIFEST)" \
	  KUSTOMIZATION="$(KUSTOMIZATION)" RENDERED_MANIFEST="$(RENDERED_MANIFEST)" DEPLOY_BATCH_DIR="$(DEPLOY_BATCH_DIR)" \
	  KUBECONFIG="$(KUBECONFIG)" HELPER="$(HELPER)" bash "$(CLEAN)"
